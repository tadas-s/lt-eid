[Unit]
Description=Lithuanian eID daemon socket
# Only in a regular user's desktop session, like the daemon.
PartOf=graphical-session.target
ConditionEnvironment=XDG_SESSION_CLASS=user

[Socket]
# Where the lt-eid PKCS#11 module looks: $XDG_RUNTIME_DIR/lt-eid/sock
ListenStream=%t/lt-eid/sock
SocketMode=0600
DirectoryMode=0700

[Install]
WantedBy=graphical-session.target
